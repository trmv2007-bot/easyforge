; Engine configuration file.
; EasyForge — AI game-maker built on Godot 4

config_version=5

[application]

config/name="EasyForge"
config/description="Describe a game in plain English. Watch it become playable."
run/main_scene="res://src/ui/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

BrickRegistry="*res://src/bricks/registry.gd"
Assets="*res://src/assets/asset_registry.gd"
BrickGraph="*res://src/bricks/graph.gd"
Compiler="*res://src/compiler/compiler.gd"
LlmClient="*res://src/ai/llm_client.gd"
SettingsStore="*res://src/core/settings_store.gd"
I18n="*res://src/i18n/i18n.gd"
GameRunner="*res://src/runtime/game_runner.gd"
GameState="*res://src/runtime/game_state.gd"
Features="*res://src/compiler/features.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/resizable=true

[debug]

settings/stdout/verbose_stdout=false
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_cast=0
gdscript/warnings/unsafe_call_argument=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
