extends Node
## gamepad — one 'Gamepad' brick that makes the compiled game controller-ready.
##
## WHAT IT ADDS
##   A small Node named "Gamepad" attached to the scene root. Every physics
##   frame it reads the LEFT analogue stick and the A button directly from
##   Godot's SDL layer and writes them into the player's `velocity`. It runs
##   ALONGSIDE the Move brick's script instead of replacing it, so the
##   keyboard controls keep working untouched — the joystick only overwrites
##   `velocity` when it reports input above the deadzone, and never touches
##   `velocity.y` (2D) so gravity and the Move brick's jump logic keep running.
##
## WHY IT READS RAW AXES
##   A compiled EasyForge game ships with an EMPTY InputMap. `Input.get_vector`
##   would therefore return zero on every real pad, because nothing binds
##   ui_left/ui_right/ui_up/ui_down to a joy axis. So we read the raw axes:
##   Input.get_joy_axis(device, JOY_AXIS_LEFT_X / JOY_AXIS_LEFT_Y). The
##   ui_* fallback is kept only as a safety net for a player who hand-edited
##   the project's InputMap.
##
## JUMP SIGN CONTRACT
##   This deliberately MATCHES compiler.gd's _movement_source so a jump feels
##   identical whichever device you press:
##     2D — velocity.y = -JUMP (screen-down is +Y)
##     3D — velocity.y = +JUMP (screen-up is +Y)
##
## INTEGRATOR NOTES (do not need any edit here):
##   * `device` (0..3) picks which controller this brick listens to.
##   * `speed` should be set to the Move brick's Speed so the stick and the
##     keys walk at the same pace. If the integrator cannot forward it, the
##     DEFAULT_SPEED constants below are used — note 2D must scale up ~30x
##     like the Move brick does, or the player crawls.
##   * `jump` should likewise mirror the Move brick's Jump (same 2D 40x rule).

# --- joy constants (Godot 4 JOY_* enums, stable across 4.x) ---
const JOY_AXIS_LEFT_X := 0
const JOY_AXIS_LEFT_Y := 1
const JOY_BUTTON_A := 0

# Fallbacks used when the 'speed'/'jump' params are absent. The integrator
# should feed these from the Move brick so the pad matches the keyboard.
const DEFAULT_SPEED_3D := 8.0
const DEFAULT_JUMP_3D := 12.0
const DEFAULT_SPEED_2D := 240.0      # Move brick scales 8.0 * 30
const DEFAULT_JUMP_2D := 480.0       # Move brick scales 12.0 * 40

# ---------------------------------------------------------------------------
# Registration
# ---------------------------------------------------------------------------

func register(reg) -> void:
	# Pass 2: the player already exists by then, and the Move brick has had
	# its chance to attach the keyboard script.
	reg.register("gamepad", _build)

# ---------------------------------------------------------------------------
# Builder
# ---------------------------------------------------------------------------

func _build(b: Dictionary, root: Node, ctx) -> void:
	if root == null or not is_instance_valid(root):
		return
	var p := _p(b)

	var enabled := _bool(p, "enabled", true)
	var deadzone := clampf(_num(p, "deadzone", 0.2), 0.05, 0.9)
	var vibrate := _bool(p, "vibrate", true)
	var strength := clampf(_num(p, "vibrate_strength", 0.5), 0.0, 1.0)
	var device := int(clampf(_num(p, "device", 0.0), 0.0, 3.0))
	var invert_y := _bool(p, "invert_y", false)
	var is_3d := _is_3d(ctx, root)
	var speed := _speed(p, is_3d)
	var jump := _jump(p, is_3d)

	# A disabled brick still has to leave a harmless node behind so the graph
	# reads back the same either way — it simply never drives input.
	var pad := Node.new()
	pad.name = "Gamepad"
	root.add_child(pad)

	var src := _source(enabled, deadzone, vibrate, strength, device,
		invert_y, is_3d, speed, jump)
	if _attach(pad, src) != OK:
		# _attach already pushed the error; drop the bare node.
		root.remove_child(pad)
		pad.free()
		push_error("[gamepad] generated controller script failed to compile")

# ---------------------------------------------------------------------------
# The generated runtime script
# ---------------------------------------------------------------------------

func _source(enabled: bool, deadzone: float, vibrate: bool, strength: float,
		device: int, invert_y: bool, is_3d: bool, speed: float, jump: float) -> String:
	var s := ""
	s += "extends Node\n"
	s += "# Generated by EasyForge from a 'Gamepad' brick.\n"
	s += "# Left stick + A button are read straight from the SDL joy layer so\n"
	s += "# this works in a compiled game whose InputMap is empty. The Move\n"
	s += "# brick's keyboard script is never replaced — this only overwrites\n"
	s += "# velocity when the stick is outside the deadzone.\n"
	s += "const AX := %d\n" % JOY_AXIS_LEFT_X
	s += "const AY := %d\n" % JOY_AXIS_LEFT_Y
	s += "const BTN_A := %d\n" % JOY_BUTTON_A
	s += "const DEADZONE := %f\n" % deadzone
	s += "const SPEED := %f\n" % speed
	s += "const JUMP := %f\n" % jump
	s += "const DEVICE := %d\n" % device
	s += "const VIBRATE := %s\n" % ("true" if vibrate else "false")
	s += "const VIB_STRENGTH := %f\n" % strength
	s += "const INVERT_Y := %s\n" % ("true" if invert_y else "false")
	s += "const JUMP_SIGN := %d\n" % (-1 if not is_3d else 1)
	s += "const ENABLED := %s\n" % ("true" if enabled else "false")
	s += "var _player = null\n"
	s += "var _vib_cool := 0.0\n"
	s += "var _shake_was := 0.0\n"
	s += "\n"
	s += "func _ready() -> void:\n"
	s += "	_player = _find_player()\n"
	s += "\n"
	s += "func _physics_process(delta: float) -> void:\n"
	# A detached node has no tree (the compiler builds roots off-scene, and
	# tests instantiate/drive them directly). Guard before every group query.
	s += "	var t := get_tree()\n"
	s += "	if t == null:\n"
	s += "		return\n"
	s += "	# A disabled brick still compiles (so the graph reads back the same);\n"
	s += "	# it simply never drives anything.\n"
	s += "	if not ENABLED:\n"
	s += "		return\n"
	s += "	if _vib_cool > 0.0:\n"
	s += "		_vib_cool -= delta\n"
	s += "	# Re-resolve every frame: the player may not exist at _ready, may\n"
	s += "	# be freed by a respawn, or may be replaced by a checkpoint reload.\n"
	s += "	if _player == null or not is_instance_valid(_player):\n"
	s += "		_player = _find_player()\n"
	s += "	if _player == null:\n"
	s += "		return\n"
	s += "	_watch_damage()\n"
	# Hot-plug: no controller on this slot -> do nothing at all.
	s += "\tif not Input.is_joy_known(DEVICE):\n"
	s += "\t\treturn\n"
	s += "\t# --- left stick, circular deadzone then renormalised so diagonal\n"
	s += "\t#     movement is not faster than straight movement ---\n"
	s += "	var ax: float = Input.get_joy_axis(DEVICE, AX)\n"
	s += "	var ay: float = Input.get_joy_axis(DEVICE, AY)\n"
	s += "\tif not ax is float:\n"
	s += "\t\tax = 0.0\n"
	s += "\tif not ay is float:\n"
	s += "\t\tay = 0.0\n"
	s += "\tif INVERT_Y:\n"
	s += "\t\tay = -ay\n"
	s += "\tvar stick := Vector2(ax, ay)\n"
	s += "\tvar mag := stick.length()\n"
	s += "\tif mag > DEADZONE:\n"
	s += "\t\tstick = stick / mag * ((mag - DEADZONE) / (1.0 - DEADZONE))\n"
	s += "\telse:\n"
	s += "\t\tstick = Vector2.ZERO\n"
	s += "	if stick.length() > 0.0:\n"
	s += "		stick = stick.limit_length(1.0)\n"
	s += "	# ui_* fallback: only meaningful if a player set up an InputMap.\n"
	s += "	var ui: Vector2 = Input.get_vector(\"ui_left\", \"ui_right\", \"ui_up\", \"ui_down\")\n"
	s += "	if ui.length() > stick.length():\n"
	s += "		stick = ui\n"
	s += "\t# --- apply ---\n"
	if is_3d:
		# 3D: stick X -> world X, stick Y -> world Z (top-down camera
		# convention: pushing the stick down walks away from the camera).
		s += "\tif stick.length() > 0.0:\n"
		s += "\t\t_player.velocity.x = stick.x * SPEED\n"
		s += "\t\t_player.velocity.z = stick.y * SPEED\n"
		s += "\t# velocity.y is left alone so the Move brick's gravity owns it.\n"
		s += "\tif Input.is_joy_button_pressed(DEVICE, BTN_A) and _player.is_on_floor():\n"
		s += "\t\t_player.velocity.y = JUMP * JUMP_SIGN\n"
	else:
		s += "\tif stick.length() > 0.0:\n"
		s += "\t\t_player.velocity.x = stick.x * SPEED\n"
		s += "\t# velocity.y is left alone: gravity + the Move brick's\n"
		s += "\t# coyote/buffer/jump-cut logic depend on owning that axis.\n"
		s += "\tif Input.is_joy_button_pressed(DEVICE, BTN_A) and _player.is_on_floor():\n"
		s += "\t\t_player.velocity.y = JUMP * JUMP_SIGN\n"
	s += "\n"
	s += "# --- rumble on damage, driven by the hazard brick's existing signal ---\n"
	s += "# The Hazard brick sets GameState var \"__shake\" to 1.0 on contact and\n"
	s += "# the camera decays it. We watch for the rising edge instead of\n"
	s += "# editing the hazard brick at all.\n"
	s += "func _watch_damage() -> void:\n"
	s += "	var sk: float = float(GameState.get_var(\"__shake\", 0.0))\n"
	s += "	if sk > _shake_was and sk > 0.0 and _vib_cool <= 0.0:\n"
	s += "		if VIBRATE and Input.is_joy_known(DEVICE):\n"
	s += "			Input.start_joy_vibration(DEVICE, VIB_STRENGTH, VIB_STRENGTH, 0.25)\n"
	s += "		_vib_cool = 0.3\n"
	s += "	_shake_was = sk\n"
	s += "\n"
	s += "# Null-tree safe player lookup: returns null when this node is not in a\n"
	s += "# tree yet (the compiler builds roots detached, and driving a node by\n"
	s += "# hand outside the tree is a normal test path).\n"
	s += "func _find_player():\n"
	s += "	var t := get_tree()\n"
	s += "	if t == null:\n"
	s += "		return null\n"
	s += "	return t.get_first_node_in_group(\"player\")\n"
	return s

# ---------------------------------------------------------------------------
# Script attach. Deliberately a LOCAL copy rather than a FeatureCtx call: the
# class_name `FeatureCtx` is not in this project's global_script_class_cache
# (compiler.gd never names it), so referencing it here would fail to parse.
# The body is byte-for-byte the behaviour of FeatureCtx.attach_script.
# ---------------------------------------------------------------------------

func _attach(node: Node, source: String) -> int:
	var s := GDScript.new()
	s.source_code = source
	var err := s.reload()
	if err == OK:
		node.set_script(s)
	else:
		push_error("[gamepad] generated script failed to compile:\n" + source)
	return err

# ---------------------------------------------------------------------------
# Param helpers — same defensive contract as FeatureCtx, so a brick with a
# missing/null/wrong-typed params dict still compiles to something harmless.
# ---------------------------------------------------------------------------

func _p(b) -> Dictionary:
	if b is Dictionary:
		var v = b.get("params")
		if v is Dictionary:
			return v
	return {}

func _num(d: Dictionary, key: String, fallback: float) -> float:
	var x = d.get(key)
	if x is float or x is int:
		return float(x)
	if x is String and str(x).is_valid_float():
		return float(x)
	return fallback

func _bool(d: Dictionary, key: String, fallback: bool) -> bool:
	var v = d.get(key)
	if v == null:
		return fallback
	if v is bool:
		return v
	if v is float or v is int:
		return v != 0
	if v is String:
		return str(v).to_lower() in ["true", "1", "yes"]
	return fallback

func _is_3d(ctx, root: Node) -> bool:
	if ctx != null and ctx is Dictionary:
		var v = ctx.get("is_3d")
		if v is bool:
			return v
	if root != null and is_instance_valid(root):
		return root is Node3D
	return true

# Move-brick scale rules, mirrored from compiler.gd so the pad and the keys
# move at the same pace. 2D multiplies by 30/40 (and clamps) because 2D
# gravity is ~980 while 3D is ~9.8.
func _speed(p: Dictionary, is_3d: bool) -> float:
	var v = _num(p, "speed", 0.0)
	if v <= 0.0:
		return DEFAULT_SPEED_3D if is_3d else DEFAULT_SPEED_2D
	if is_3d:
		return clampf(v, 1.0, 40.0)
	return clampf(v * 30.0, 60.0, 900.0)

func _jump(p: Dictionary, is_3d: bool) -> float:
	var v = _num(p, "jump", 0.0)
	if v <= 0.0:
		return DEFAULT_JUMP_3D if is_3d else DEFAULT_JUMP_2D
	if is_3d:
		return clampf(v, 0.0, 40.0)
	return clampf(v * 40.0, 100.0, 1200.0)
