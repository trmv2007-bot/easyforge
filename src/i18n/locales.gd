	"problem_jump_tip": {"en": "Press to select and show the brick this is about", "hi": "दबाने पर संबंधित ब्रिक चुनकर दिखाई देगी", "es": "Pulsa para seleccionar y mostrar el ladrillo afectado", "zh": "点一下就能选中并显示相关积木", "ar": "اضغط لتحديد الطوبة المقصودة وإظهارها", "pt": "Clique para selecionar e mostrar o bloco envolvido", "fr": "Clique pour sélectionner et montrer la brique concernée", "de": "Drücken, um den betreffenden Baustein auszuwählen und zu zeigen", "ja": "押すと該当のブロックを選んで見せます", "ru": "Нажми, чтобы выделить и показать нужный блок"},
	"canvas_empty": {"en": "Nothing here yet. Press a brick on the left to add it, or type your idea and make a game.", "hi": "अभी यहाँ कुछ नहीं है। बाईं ओर किसी ब्रिक को दबाकर उसे जोड़ें, या अपना विचार लिखें।", "es": "Aquí no hay nada todavía. Pulsa un ladrillo a la izquierda para añadirlo, o describe tu idea.", "zh": "这里还什么都没有。点左边的积木就能加上，或者写下你的点子。", "ar": "لا شيء هنا بعد. اضغط طوبة على اليسار لإضافتها، أو صِف فكرتك.", "pt": "Ainda não tem nada aqui. Clique num bloco à esquerda para adicionar, ou descreva sua ideia.", "fr": "Rien ici pour l'instant. Clique une brique à gauche pour l'ajouter, ou décris ton idée.", "de": "Hier ist noch nichts. Drücke links einen Baustein, um ihn zu setzen, oder beschreibe deine Idee.", "ja": "まだ何もありません。左のブロックを押すと追加できます。アイデアを書くこともできます。", "ru": "Здесь пока пусто. Нажми блок слева, чтобы добавить его, или опиши свою идею."},
	"canvas_empty_play": {"en": "There is nothing to play yet — add a Character brick first.", "hi": "अभी खेलने को कुछ नहीं — पहले एक किरदार ब्रिक जोड़ें।", "es": "No hay nada que jugar aún — añade primero un ladrillo de Personaje.", "zh": "现在没有可玩的内容——先加一个角色积木。", "ar": "لا شيء يُلعَب بعد — أضف طوبة شخصية أولًا.", "pt": "Nada para jogar ainda — adicione primeiro um bloco de Personagem.", "fr": "Rien à jouer pour l'instant — ajoute d'abord une brique Personnage.", "de": "Es gibt noch nichts zu spielen — füge zuerst einen Charakter-Baustein hinzu.", "ja": "まだプレイできるものはありません。まずキャラクターのブロックを追加してください。", "ru": "Играть пока нечего — добавь сначала блок Персонаж."},
	"play_build_failed": {"en": "This could not be built into a game — the list under the canvas says why.", "hi": "इससे खेल नहीं बना — कैनवस के नीचे की सूची में कारण है।", "es": "No se pudo construir un juego — la lista bajo el lienzo dice por qué.", "zh": "没能做成可玩的游戏——画布下面的列表写着原因。", "ar": "لم نستطع بناء لعبة — السبب في القائمة أسفل اللوحة.", "pt": "Não deu para montar um jogo — a lista abaixo do quadro explica o motivo.", "fr": "Impossible d'en faire un jeu — la liste sous le canevas explique pourquoi.", "de": "Daraus ließ sich kein Spiel bauen — die Liste unter der Fläche sagt warum.", "ja": "ゲームとして組み立てられませんでした — キャンバス下のリストに理由があります。", "ru": "Игра не собралась — список под холстом объясняет причину."},
	"search_bricks_tip": {"en": "Searches every brick, including the hidden specialist ones — try 'die', 'bad guy' or 'menu'", "hi": "सभी ब्रिक्स खोजता है, छिपी विशेष ब्रिक्स भी — 'मरना', 'दुश्मन', 'मेन्यू' आज़माएँ", "es": "Busca todos los ladrillos, también los especializados ocultos — prueba «morir», «enemigo» o «menú»", "zh": "搜索全部积木，包括被收起的专业积木——试试“死亡”“敌人”“菜单”", "ar": "يبحث في كل الطوب، حتى المتخصصة المخفية — جرّب «يموت» أو «عدو» أو «قائمة»", "pt": "Procura todos os blocos, inclusive os especializados escondidos — tente 'morrer', 'inimigo' ou 'menu'", "fr": "Cherche toutes les briques, même les spécialisées cachées — essaie « mourir », « ennemi » ou « menu »", "de": "Sucht alle Bausteine, auch die versteckten Spezialisten — versuche „sterben“, „Bösewicht“ oder „Menü“", "ja": "隠れている専門ブロックも含めて全部検索します —「死ぬ」「敵」「メニュー」など", "ru": "Ищет все блоки, включая спрятанные специальные — попробуй «умереть», «враг» или «меню»"},
	"search_try_words": {"en": "Try a plain word for what you want: 'jump', 'die', 'coin', 'menu'.", "hi": "जो चाहिए उसे सरल शब्द में लिखें: 'कूदना', 'मरना', 'सिक्का', 'मेन्यू'।", "es": "Usa una palabra sencilla de lo que quieres: «saltar», «morir», «moneda», «menú».", "zh": "用简单的话说你想要的：跳跃、死亡、金币、菜单。", "ar": "اكتب كلمة بسيطة عمّا تريده: «يقفز»، «يموت»، «عملة»، «قائمة».", "pt": "Use uma palavra simples do que você quer: 'pular', 'morrer', 'moeda', 'menu'.", "fr": "Utilise un mot simple pour ce que tu veux : « sauter », « mourir », « pièce », « menu ».", "de": "Nimm ein einfaches Wort für das, was du willst: „springen“, „sterben“, „Münze“, „Menü“.", "ja": "簡単な言葉で入力してください：「ジャンプ」「死ぬ」「コイン」「メニュー」。", "ru": "Напиши простое слово: «прыжок», «умереть», «монета», «меню»."},
	"show_every_brick": {"en": "Show every brick", "hi": "हर ब्रिक दिखाएँ", "es": "Mostrar todos los ladrillos", "zh": "显示全部积木", "ar": "اعرض كل الطوب", "pt": "Mostrar todos os blocos", "fr": "Montrer toutes les briques", "de": "Alle Bausteine zeigen", "ja": "すべてのブロックを表示", "ru": "Показать все блоки"},
	"show_every_brick_tip": {"en": "Tick this to list the specialist bricks (lighting, physics, prefabs) in the palette too.", "hi": "चिह्नित करें तो रोशनी, भौतिकी, नमूने जैसी विशेष ब्रिक्स भी सूची में आ जाएँगी।", "es": "Márcalo para ver también los ladrillos especializados (luces, física, plantillas).", "zh": "勾选后，灯光、物理、预制体这些专业积木也会列出来。", "ar": "فعّل هذا لتظهر الطوب المتخصصة (الإضاءة، الفيزياء، القوالب) في القائمة.", "pt": "Marque para listar também os blocos especializados (luz, física, modelos).", "fr": "Coche pour afficher aussi les briques spécialisées (lumière, physique, modèles).", "de": "Aktiviere das, um auch Spezial-Bausteine (Licht, Physik, Vorlagen) in der Liste zu sehen.", "ja": "チェックすると、照明・物理・テンプレートなどの専門ブロックも一覧に出ます。", "ru": "Включи, чтобы в списке появились и специальные блоки (свет, физика, шаблоны)."},
	"show_more_bricks": {"en": "Show the specialist bricks", "hi": "विशेष ब्रिक्स दिखाएँ", "es": "Mostrar los ladrillos especializados", "zh": "显示专业积木", "ar": "اعرض الطوب المتخصصة", "pt": "Mostrar os blocos especializados", "fr": "Montrer les briques spécialisées", "de": "Die Spezial-Bausteine zeigen", "ja": "専門ブロックを表示", "ru": "Показать специальные блоки"},
	"fit_view_tip": {"en": "Fit the whole game on screen", "hi": "पूरा खेल एक साथ स्क्रीन पर दिखाएँ", "es": "Ver todo el juego en pantalla", "zh": "把整个游戏放进屏幕", "ar": "اعرض اللعبة كاملة على الشاشة", "pt": "Ver o jogo inteiro na tela", "fr": "Afficher tout le jeu à l'écran", "de": "Das ganze Spiel auf den Bildschirm bringen", "ja": "ゲーム全体を画面に収める", "ru": "Показать всю игру на экране"},
	"zoom_in_tip": {"en": "Zoom in", "hi": "बड़ा करें", "es": "Acercar", "zh": "放大", "ar": "تكبير", "pt": "Aumentar o zoom", "fr": "Zoom avant", "de": "Vergrößern", "ja": "拡大", "ru": "Приблизить"},
	"zoom_out_tip": {"en": "Zoom out", "hi": "छोटा करें", "es": "Alejar", "zh": "缩小", "ar": "تصغير", "pt": "Diminuir o zoom", "fr": "Zoom arrière", "de": "Verkleinern", "ja": "縮小", "ru": "Отдалить"},
	"tidy_layout_tip": {"en": "Arrange the bricks in reading order", "hi": "ब्रिक्स को पढ़ने के क्रम में सजाएँ", "es": "Ordenar los ladrillos en orden de lectura", "zh": "把积木按阅读顺序排好", "ar": "رتّب الطوب بترتيب القراءة", "pt": "Organizar os blocos em ordem de leitura", "fr": "Ranger les briques dans l'ordre de lecture", "de": "Bausteine in Lesereihenfolge anordnen", "ja": "ブロックを読みやすい順に並べる", "ru": "Выстроить блоки по порядку чтения"},
	"tidy_layout_done": {"en": "Bricks laid out in the order your game runs them", "hi": "खेल इन्हें जिस क्रम में चलाता है, ब्रिक्स उसी क्रम में सजा दीं", "es": "Ladrillos ordenados según los ejecuta el juego", "zh": "已按游戏的运行顺序排好积木", "ar": "رُتّبت الطوب بحسب ترتيب تنفيذ اللعبة لها", "pt": "Blocos organizados na ordem que o jogo executa", "fr": "Briques rangées dans l'ordre où le jeu les exécute", "de": "Bausteine in Ablaufreihenfolge angeordnet", "ja": "ゲームが動く順にブロックを並べ替えました", "ru": "Блоки выстроены в порядке исполнения игры"},
	"node_settings_tip": {"en": "Show and change this brick's settings", "hi": "इस ब्रिक की सेटिंग दिखाएँ और बदलें", "es": "Mostrar y cambiar los ajustes de este ladrillo", "zh": "展开并修改这块积木的设置", "ar": "اعرض وغيّر إعدادات هذه الطوبة", "pt": "Mostrar e mudar os ajustes deste bloco", "fr": "Afficher et modifier les réglages de cette brique", "de": "Einstellungen dieses Bausteins zeigen und ändern", "ja": "このブロックの設定を表示して変更", "ru": "Показать и изменить настройки этого блока"},
	"brick_comment_tip": {"en": "A note to yourself. The AI reads it when you ask for changes.", "hi": "यह आपके लिए नोट है। बदलाव माँगते समय AI इसे पढ़ता है।", "es": "Una nota para ti. La IA la lee cuando pides cambios.", "zh": "给自己的备注。AI在你要求修改时会读它。", "ar": "ملاحظة لنفسك. يقرأها الذكاء الاصطناعي حين تطلب تعديلات.", "pt": "Um recado para você. A IA lê isso quando você pede mudanças.", "fr": "Une note pour toi. L'IA la lit quand tu demandes des modifications.", "de": "Eine Notiz für dich. Die KI liest sie, wenn du nach Änderungen fragst.", "ja": "自分向けのメモです。変更を求める際にAIが読みます。", "ru": "Заметка для себя. ИИ читает её, когда ты просишь изменить игру."},
	"add_these_bricks": {"en": "Add these bricks", "hi": "इन ब्रिक्स को जोड़ें", "es": "Añadir estos ladrillos", "zh": "添加这些积木", "ar": "أضف هذه الطوب", "pt": "Adicionar estes blocos", "fr": "Ajouter ces briques", "de": "Diese Bausteine hinzufügen", "ja": "このブロックを追加", "ru": "Добавить эти блоки"},
	"recipe_undo_hint": {"en": "Ctrl+Z takes it back.", "hi": "Ctrl+Z से वापस ले सकते हैं।", "es": "Ctrl+Z lo quita.", "zh": "Ctrl+Z 可以撤销。", "ar": "يمكنك التراجع بـ Ctrl+Z.", "pt": "Ctrl+Z desfaz.", "fr": "Ctrl+Z annule l'ajout.", "de": "Strg+Z nimmt es zurück.", "ja": "Ctrl+Z で取り消せます。", "ru": "Ctrl+Z вернёт всё назад."},
	"tutorial_try_recipes": {"en": "Show me the recipes", "hi": "मुझे नुस्खे दिखाएँ", "es": "Enséñame las recetas", "zh": "给我看配方", "ar": "أرني الوصفات", "pt": "Me mostre as receitas", "fr": "Montre-moi les recettes", "de": "Zeig mir die Rezepte", "ja": "レシピを見せて", "ru": "Покажи рецепты"},
	"language_applies_note": {"en": "Language saved. The buttons update the next time EasyForge opens; your game's own text never changes.", "hi": "भाषा सहेजी गई। बटन अगली बार खोलने पर बदलेंगे; तुम्हारे खेल का पाठ नहीं बदलेगा।", "es": "Idioma guardado. Los botones cambian al volver a abrir EasyForge; el texto de tu juego no cambia.", "zh": "语言已保存。按钮文字会在下次启动时更新；游戏里的文字不受影响。", "ar": "تم حفظ اللغة. تتغير الأزرار عند التشغيل القادم، أما نص لعبتك فلا يتغير.", "pt": "Idioma salvo. Os botões mudam na próxima abertura; o texto do seu jogo não muda.", "fr": "Langue enregistrée. Les boutons changeront au prochain démarrage ; le texte de ton jeu ne bouge pas.", "de": "Sprache gespeichert. Die Knöpfe ändern sich beim nächsten Start; der Text deines Spiels bleibt unverändert.", "ja": "言語を保存しました。ボタンの表示は次回起動時に変わります。ゲーム内の文章は変わりません。", "ru": "Язык сохранён. Кнопки изменятся после перезапуска, а текст твоей игры останется как есть."},
	"blank_project": {"en": "Start from nothing", "hi": "शून्य से शुरू करें", "es": "Empezar de cero", "zh": "从零开始", "ar": "ابدأ من الصفر", "pt": "Começar do zero", "fr": "Partir de zéro", "de": "Ganz von vorn", "ja": "何もない状態から始める", "ru": "Начать с нуля"},
	"blank_project_pitch": {"en": "An empty canvas: add the bricks yourself, one at a time.", "hi": "एक खाली कैनवस: ब्रिक्स खुद जोड़ें, एक-एक करके।", "es": "Un lienzo vacío: añade los ladrillos tú mismo, uno a uno.", "zh": "空白画布：自己一块一块地加积木。", "ar": "لوحة فارغة: أضف الطوب بنفسك، طوبة طوبة.", "pt": "Um quadro vazio: adicione os blocos você mesmo, um por vez.", "fr": "Un canevas vide : ajoute les briques toi-même, une par une.", "de": "Eine leere Fläche: füge die Bausteine selbst einzeln hinzu.", "ja": "空のキャンバス。ブロックをひとつずつ自分で追加します。", "ru": "Пустой холст: добавляй блоки сам, по одному."},
	"prompt_hint": {"en": "Your game, in one sentence", "hi": "अपना खेल, एक वाक्य में", "es": "Tu juego, en una frase", "zh": "一句话描述你的游戏", "ar": "لعبتك في جملة واحدة", "pt": "Seu jogo, em uma frase", "fr": "Ton jeu, en une phrase", "de": "Dein Spiel, in einem Satz", "ja": "あなたのゲームを一文で", "ru": "Твоя игра в одном предложении"},
	"chat_hint": {"en": "Ask for one change", "hi": "एक बदलाव मांगें", "es": "Pide un cambio", "zh": "说一个要改的地方", "ar": "اطلب تغييرًا واحدًا", "pt": "Peça uma mudança", "fr": "Demande une modification", "de": "Bitte um eine Änderung", "ja": "変更をひとつ依鼴", "ru": "Попроси об одном изменении"},
	"preview_click_hint": {"en": "click to play", "hi": "खेलने के लिए क्लिक करें", "es": "clic para jugar", "zh": "点击即玩", "ar": "انقر لتلعب", "pt": "clique para jogar", "fr": "cliquer pour jouer", "de": "Klicken zum Spielen", "ja": "クリックでプレイ", "ru": "нажми, чтобы играть"},
	"canvas_wire_hint": {"en": "Drag from a port on the right of one brick to a port on the left of the next. Double-click empty space to add a brick.", "hi": "एक ब्रिक के दायें पोर्ट से अगली ब्रिक के बाएं पोर्ट तक खींचें। खाली जगह डबल-क्लिक से ब्रिक जोड़ती है।", "es": "Arrastra desde un puerto derecho de un ladrillo a un puerto izquierdo del siguiente. Doble clic en el vacío para añadir un ladrillo.", "zh": "从一个积木右边的接口拖到下一个积木左边的接口。在空白处双击可以加积木。", "ar": "اسحب من فتحة يمين طوبة إلى فتحة يسار الطوبة التالية. النقر المزدوج في فراغ يضيف طوبة.", "pt": "Arraste de uma porta à direita de um bloco para uma porta à esquerda do próximo. Clique duplo no vazio adiciona um bloco.", "fr": "Fais glisser un port à droite d'une brique vers un port à gauche de la suivante. Double-clique dans le vide pour ajouter une brique.", "de": "Vom Port rechts an einem Baustein zum Port links am nächsten ziehen. Doppelklick auf freie Fläche fügt einen Baustein hinzu.", "ja": "ブロックの右のポートから次のブロックの左のポートへドラッグ。何もない場所をダブルクリックすると追加できます。", "ru": "Тяни от правого порта блока к левому порту следующего. Двойной щелчок по пустому месту добавит блок."},
	"offline_no_key": {"en": "No AI key, so this game was laid out from EasyForge's own genre library", "hi": "AI कुंजी नहीं, इसलिए यह खेल EasyForge की अपनी शैली-पुस्तकोश से बना गया", "es": "Sin clave de IA: este juego se montó desde la biblioteca de géneros de EasyForge", "zh": "没有AI密钥，所以这个游戏是用EasyForge自带的类型库搭出来的", "ar": "لا مفتاح للذكاء الاصطناعي، لذا بُنيت هذه اللعبة من مكتبة الأنواع في EasyForge", "pt": "Sem chave de IA: este jogo foi montado a partir da biblioteca de gêneros do EasyForge", "fr": "Aucune clé IA : ce jeu a été composé depuis la bibliothèque de genres d'EasyForge", "de": "Kein KI-Schlüssel, deshalb wurde dieses Spiel aus EasyForges eigener Genrebibliothek gebaut", "ja": "AIキーがないため、EasyForge内藏のジャンルライブラリから組み立てました", "ru": "Ключа ИИ нет, поэтому игра собрана из собственной библиотеки жанров EasyForge"},
	"offline_after_ai": {"en": "The AI could not deliver, so these bricks came from EasyForge's own genre library", "hi": "AI कुछ नहीं दे पाया, ई ब्रिक्स EasyForge की अपनी शैली-पुस्तकोश से हैं", "es": "La IA no pudo entregar: estos ladrillos salen de la biblioteca de géneros de EasyForge", "zh": "AI没给出结果，这些积木来自EasyForge自带的类型库", "ar": "عجز الذكاء الاصطناعي، هذه الطوب من مكتبة الأنواع في EasyForge", "pt": "A IA não entregou: estes blocos vêm da biblioteca de gêneros do EasyForge", "fr": "L'IA n'a rien fourni : ces briques viennent de la bibliothèque de genres d'EasyForge", "de": "Die KI hat es nicht gebracht — diese Bausteine kommen aus EasyForges eigener Genrebibliothek", "ja": "AIが応答できなかったため、EasyForge内藏のジャンルライブラリを使いました", "ru": "ИИ не справился — эти блоки взяты из библиотеки жанров EasyForge"},
	"offline_guessed": {"en": "I could not tell which genre that is, so I started with", "hi": "शैली पहचान नहीं लगा, इसलिए शुरू कर रहा हूं:", "es": "No supe qué género era, así que empiezo con", "zh": "我拿不准这是哪个类型，先按这个来：", "ar": "لم أستطع تحديد النوع، لذا أبدأ مع", "pt": "Não deu para saber o gênero, então começo com", "fr": "Je n'ai pas pu deviner le genre, alors je commence avec", "de": "Ich konnte das Genre nicht erkennen, deshalb starte ich mit", "ja": "ジャンルを判別できなかったので、こちらから始めます：", "ru": "Не удалось определить жанр, поэтому начинаю с"},
	"open_now": {"en": "open now", "hi": "अब्यँद खुला है", "es": "ya abierto", "zh": "已打开", "ar": "مفتوحة الآن", "pt": "já aberto", "fr": "déjà ouvert", "de": "geöffnet", "ja": "開いたもの", "ru": "уже открыта"},
