	"brick_pasted": {"en": "Pasted", "hi": "पेस्ट हुआ", "es": "Pegado", "zh": "已粘贴", "ar": "تم اللصق", "pt": "Colado", "fr": "Collé", "de": "Eingefügt", "ja": "貼り付けました", "ru": "Вставлено"},
	"brick_settings": {"en": "Settings", "hi": "सेटिंग्स", "es": "Ajustes", "zh": "设置", "ar": "الإعدادات", "pt": "Configurações", "fr": "Réglages", "de": "Einstellungen", "ja": "設定", "ru": "Настройки"},
	"ai_edit": {"en": "Edit with AI", "hi": "AI से बदलें", "es": "Editar con IA", "zh": "用AI修改", "ar": "عدّل بالذكاء الاصطناعي", "pt": "Editar com IA", "fr": "Modifier avec l'IA", "de": "Mit KI bearbeiten", "ja": "AIで編集", "ru": "Изменить с ИИ"},
	"ai_edit_placeholder": {"en": "e.g. \"add an enemy\" or \"make it harder\"", "hi": "जैसे \"एक दुश्मन जोड़ो\" या \"इसे और कठिन बनाओ\"", "es": "P. ej. «añade un enemigo» o «hazlo más difícil»", "zh": "例如「添加一个敌人」或「让它更难」", "ar": "مثل «أضف عدوًا» أو «اجعلها أصعب»", "pt": "Ex.: \"adicione um inimigo\" ou \"deixe mais difícil\"", "fr": "Ex. : « ajoute un ennemi » ou « rends-le plus difficile »", "de": "Zum Beispiel „einen Gegner hinzufügen\" oder „schwieriger machen\"", "ja": "例：「敵を追加」や「もっと難しくして」", "ru": "Например: «добавь врага» или «сделай посложнее»"},
	"ai_edit_apply": {"en": "Apply", "hi": "लागू करें", "es": "Aplicar", "zh": "应用", "ar": "تطبيق", "pt": "Aplicar", "fr": "Appliquer", "de": "Anwenden", "ja": "適用", "ru": "Применить"},
	"undo": {"en": "Undo", "hi": "वापस करें", "es": "Deshacer", "zh": "撤销", "ar": "تراجع", "pt": "Desfazer", "fr": "Annuler", "de": "Rückgängig", "ja": "元に戻す", "ru": "Отменить"},
	"ai_edit_done": {"en": "AI updated your game. Press Play to try it.", "hi": "AI ने आपका गेम बदल दिया। खेलें दबाकर देखें।", "es": "La IA ha actualizado tu juego. Pulsa Jugar para probarlo.", "zh": "AI已经改好你的游戏。点击开始试一试。", "ar": "حدّث الذكاء الاصطناعي لعبتك. اضغط العب لتجربتها.", "pt": "A IA atualizou seu jogo. Pressione Jogar para testar.", "fr": "L'IA a mis à jour votre jeu. Appuyez sur Jouer pour l'essayer.", "de": "Die KI hat dein Spiel aktualisiert. Drücke Spielen, um es zu testen.", "ja": "AIがゲームを更新しました。プレイを押して試してみてください。", "ru": "ИИ обновил вашу игру. Нажмите «Играть», чтобы попробовать."},
	"ai_edit_nothing": {"en": "The AI couldn't apply that change. Try rephrasing.", "hi": "AI वह बदलाव नहीं कर सका। दूसरे शब्दों में लिखें।", "es": "La IA no pudo aplicar ese cambio. Escríbelo de otra forma.", "zh": "AI没能应用这个改动。换个说法试试。", "ar": "لم يستطع الذكاء الاصطناعي تطبيق هذا التعديل. جرّب صياغة أخرى.", "pt": "A IA não conseguiu aplicar essa mudança. Tente escrever de outro jeito.", "fr": "L'IA n'a pas pu appliquer ce changement. Essayez une autre formulation.", "de": "Die KI konnte diese Änderung nicht umsetzen. Formuliere es anders.", "ja": "AIはその変更を適用できませんでした。言い方を変えてみてください。", "ru": "ИИ не смог применить это изменение. Попробуйте сформулировать иначе."},
	"undo_done": {"en": "Reverted the last AI change.", "hi": "AI का आखिरी बदलाव वापस कर दिया।", "es": "Se deshizo el último cambio de la IA.", "zh": "已撤销AI的上一次改动。", "ar": "تم التراجع عن آخر تعديل للذكاء الاصطناعي.", "pt": "Última mudança da IA desfeita.", "fr": "Dernier changement de l'IA annulé.", "de": "Die letzte KI-Änderung wurde rückgängig gemacht.", "ja": "AIの最後の変更をもとに戻しました。", "ru": "Последнее изменение ИИ отменено."},
	"redo": {"en": "Redo", "hi": "दोबारा करें", "es": "Rehacer", "zh": "重做", "ar": "إعادة", "pt": "Refazer", "fr": "Rétablir", "de": "Wiederholen", "ja": "やり直し", "ru": "Повторить"},
	"search_bricks": {"en": "Search bricks…", "hi": "ब्रिक खोजें…", "es": "Buscar bloques…", "zh": "搜索积木…", "ar": "ابحث عن طوب…", "pt": "Pesquisar blocos…", "fr": "Rechercher des briques…", "de": "Bausteine suchen…", "ja": "ブロックを検索…", "ru": "Поиск блоков…"},
	"search_no_bricks": {"en": "No bricks match. Try another word.", "hi": "कोई ब्रिक नहीं मिला। दूसरा शब्द आज़माएँ।", "es": "Ningún bloque coincide. Prueba otra palabra.", "zh": "没有匹配的积木。换个词试试。", "ar": "لا يوجد طوب مطابق. جرّب كلمة أخرى.", "pt": "Nenhum bloco corresponde. Tente outra palavra.", "fr": "Aucune brique ne correspond. Essayez un autre mot.", "de": "Kein Baustein gefunden. Versuche ein anderes Wort.", "ja": "一致するブロックがありません。別の言葉で試してみてください。", "ru": "Ничего не найдено. Попробуйте другое слово."},
	"suggest_next": {"en": "Try adding:", "hi": "यह जोड़कर देखें:", "es": "Prueba a añadir:", "zh": "试着添加：", "ar": "جرّب إضافة:", "pt": "Tente adicionar:", "fr": "Essayez d'ajouter :", "de": "Füge mal hinzu:", "ja": "次はこれを追加：", "ru": "Попробуйте добавить:"},
	"export_web": {"en": "Publish to Web", "hi": "वेब पर प्रकाशित करें", "es": "Publicar en la web", "zh": "发布到网页", "ar": "انشر على الويب", "pt": "Publicar na web", "fr": "Publier sur le Web", "de": "Im Web veröffentlichen", "ja": "Webに公開", "ru": "Опубликовать в вебе"},
	"export_web_tip": {"en": "Build a browser-playable version you can share as a link", "hi": "ब्राउज़र में चलने वाला संस्करण बनाएँ, जिसे लिंक से साझा करें", "es": "Crea una versión que funciona en el navegador y puedes compartir como enlace", "zh": "生成可以在浏览器里玩的版本，用链接就能分享", "ar": "أنشئ نسخة تعمل في المتصفح يمكنك مشاركتها كرابط", "pt": "Crie uma versão que roda no navegador e que você pode compartilhar por link", "fr": "Créez une version jouable dans le navigateur, à partager par lien", "de": "Erstelle eine Version, die im Browser läuft und die du als Link teilen kannst", "ja": "ブラウザで遊べるバージョンを作り、リンクで共有できます", "ru": "Соберите версию, которая запускается в браузере и которой можно поделиться по ссылке"},
	"export_web_running": {"en": "Building the web version... this takes a minute.", "hi": "वेब संस्करण बन रहा है... एक मिनट लगेगा।", "es": "Creando la versión web... lleva un minuto.", "zh": "正在生成网页版……需要一分钟。", "ar": "يجري إنشاء نسخة الويب... يستغرق دقيقة.", "pt": "Gerando a versão web... leva um minuto.", "fr": "Création de la version Web... cela prend une minute.", "de": "Die Web-Version wird erstellt... das dauert eine Minute.", "ja": "Webバージョンを作成しています... 1分かかります。", "ru": "Собираем веб-версию... это займёт минуту."},
	"export_web_done": {"en": "Web version built! Opening the build/web folder.", "hi": "वेब संस्करण तैयार! build/web फ़ोल्डर खोल रहे हैं।", "es": "¡Versión web lista! Abriendo la carpeta build/web.", "zh": "网页版已生成！正在打开 build/web 文件夹。", "ar": "تم إنشاء نسخة الويب! يجري فتح المجلد build/web.", "pt": "Versão web pronta! Abrindo a pasta build/web.", "fr": "Version Web créée ! Ouverture du dossier build/web.", "de": "Web-Version fertig! Der Ordner build/web wird geöffnet.", "ja": "Webバージョンが完成しました！build/web フォルダを開きます。", "ru": "Веб-версия готова! Открываем папку build/web."},
	"export_web_notemplates": {"en": "Web export needs the Godot web templates (one-time download). Run: godot --headless --export-release \"Web\" build/web/index.html after installing them from godotengine.org.", "hi": "वेब एक्सपोर्ट के लिए Godot के वेब टेम्पलेट्स चाहिए (एक बार डाउनलोड)। godotengine.org से इन्हें इंस्टॉल करने के बाद चलाएँ: godot --headless --export-release \"Web\" build/web/index.html", "es": "La exportación web necesita las plantillas web de Godot (descarga única). Instálalas desde godotengine.org y ejecuta: godot --headless --export-release \"Web\" build/web/index.html", "zh": "网页导出需要 Godot 的网页模板（只需下载一次）。从 godotengine.org 安装好后运行：godot --headless --export-release \"Web\" build/web/index.html", "ar": "التصدير إلى الويب يتطلب قوالب Godot الخاصة بالويب (تنزيل واحد). ثبّتها من godotengine.org ثم نفّذ: godot --headless --export-release \"Web\" build/web/index.html", "pt": "A exportação para web precisa dos templates web do Godot (download único). Instale-os pelo godotengine.org e execute: godot --headless --export-release \"Web\" build/web/index.html", "fr": "L’export Web nécessite les modèles Web de Godot (téléchargement unique). Installez-les depuis godotengine.org puis exécutez : godot --headless --export-release \"Web\" build/web/index.html", "de": "Der Web-Export braucht die Godot-Web-Templates (einmaliger Download). Installiere sie von godotengine.org und führe aus: godot --headless --export-release \"Web\" build/web/index.html", "ja": "Web書き出しにはGodotのWebテンプレートが必要です（1回のダウンロード）。godotengine.org からインストールしてから、次を実行してください: godot --headless --export-release \"Web\" build/web/index.html", "ru": "Для веб-экспорта нужны веб-шаблоны Godot (загрузка один раз). Установите их с godotengine.org, затем выполните: godot --headless --export-release \"Web\" build/web/index.html"},
	"export_web_no_source": {"en": "Publish to Web needs the EasyForge folder that still has its project files (tools/ and project.godot). Run EasyForge from that folder and try again.", "hi": "वेब पर प्रकाश के लिए EasyForge फ़ोल्डर चाहिए जिसमें project.godot और tools/ हों। EasyForge को उसी फ़ोल्डर से चलाएँ और फिर कोशिश करें।", "es": "Publicar en la web necesita la carpeta de EasyForge con sus archivos de proyecto (tools/ y project.godot). Ejecuta EasyForge desde esa carpeta e inténtalo de nuevo.", "zh": "发布到网页需要包含 project.godot 和 tools/ 的 EasyForge 项目文件夹。请从该文件夹运行 EasyForge 后重试。", "ar": "النشر على الويب يحتاج إلى مجلد EasyForge الذي يحوي ملفات المشروع (tools/ و project.godot). شغّل EasyForge من ذلك المجلد ثم أعد المحاولة.", "pt": "Publicar na web precisa da pasta do EasyForge com os arquivos do projeto (tools/ e project.godot). Execute o EasyForge dessa pasta e tente de novo.", "fr": "La publication Web nécessite le dossier EasyForge avec ses fichiers de projet (tools/ et project.godot). Lancez EasyForge depuis ce dossier et réessayez.", "de": "Die Web-Veröffentlichung braucht den EasyForge-Ordner mit den Projektdateien (tools/ und project.godot). Starte EasyForge aus diesem Ordner und versuche es erneut.", "ja": "Web公開には project.godot と tools/ を含む EasyForge フォルダが必要です。そのフォルダから EasyForge を起動して再試行してください。", "ru": "Публикация в вебе требует папку EasyForge с файлами проекта (tools/ и project.godot). Запустите EasyForge из этой папки и попробуйте снова."},
	"export_web_templates_missing": {"en": "The web build needs Godot's web templates (a one-time download): open the Godot editor, then Project > Manage Export Templates > Download and Install, and try again.", "hi": "वेब बिल्ड को Godot के वेब टेम्पलेट्स चाहिए (एक बार डाउनलोड)। Godot एडिटर में «प्रोजेक्ट» → «एक्सपोर्ट टेम्पलेट प्रबंधन» → «डाउनलोड और इंस्टॉल» खोलें, फिर दोबारा कोशिश करें।", "es": "La versión web necesita las plantillas web de Godot (una sola descarga): en el editor de Godot abre Proyecto > Gestionar plantillas de exportación > Descargar e instalar, y vuelve a intentarlo.", "zh": "网页版需要 Godot 的网页导出模板（只需下载一次）：在 Godot 编辑器中打开「项目」→「管理导出模板」→「下载并安装」，然后重试。", "ar": "بناء الويب يحتاج إلى قوالب Godot الخاصة بالويب (تنزيل لمرة واحدة): افتح في محرر Godot «مشروع» ← «إدارة قوالب التصدير» ← «تنزيل وتثبيت» ثم أعد المحاولة.", "pt": "A versão web precisa dos templates web do Godot (download único): no editor do Godot, abra Projeto > Gerenciar templates de exportação > Baixar e instalar e tente novamente.", "fr": "La version Web requiert les modèles Web de Godot (téléchargement unique) : dans l'éditeur Godot, ouvrez Projet > Gérer les modèles d'exportation > Télécharger et installer, puis réessayez.", "de": "Der Web-Build benötigt Godots Web-Vorlagen (einmaliger Download): Öffne im Godot-Editor Projekt > Exportvorlagen verwalten > Herunterladen und installieren, dann erneut versuchen.", "ja": "Webビルドには Godot のWebテンプレートが必要です(初回のみダウンロード)。Godot エディターで「プロジェクト」→「エクスポートテンプレートの管理」→「ダウンロードしてインストール」を選んでから再試行してください。", "ru": "Веб-сборке нужны веб-шаблоны Godot (загрузка один раз): в редакторе Godot откройте «Проект» → «Управление шаблонами экспорта» → «Скачать и установить», затем повторите."},
	"export_web_failed": {"en": "The web build stopped with an error. Try again; if it keeps failing, run the same export from the Godot editor to see the details.", "hi": "वेब बिल्ड एक त्रुटि से रुक गया। दोबारा कोशिश करें; बार-बार असर होने पर Godot एडिटर से वही निर्यात चलाएँ और विवरण देखें।", "es": "La compilación web se detuvo con un error. Inténtalo de nuevo; si persiste, ejecuta la misma exportación desde el editor de Godot para ver los detalles.", "zh": "网页版构建因错误停止。请重试；如果一直失败，请在 Godot 编辑器中执行同样的导出以查看详情。", "ar": "توقف بناء الويب بسبب خطأ. أعد المحاولة؛ وإذا استمرت المشكلة فنفّذ التصدير نفسه من محرر Godot لترى التفاصيل.", "pt": "A compilação web parou com um erro. Tente de novo; se continuar, execute a mesma exportação no editor do Godot para ver os detalhes.", "fr": "La création de la version Web s'est arrêtée avec une erreur. Réessayez ; si le problème persiste, lancez le même export depuis l'éditeur Godot pour voir les détails.", "de": "Der Web-Build hat mit einem Fehler abgebrochen. Versuche es erneut; wenn der Fehler bleibt, führe denselben Export im Godot-Editor aus, um Details zu sehen.", "ja": "Webビルドはエラーで停止しました。もう一度お試しください。続く場合は Godot エディターから同じエクスポートを実行して詳細を確認してください。", "ru": "Веб-сборка завершилась ошибкой. Повторите; если ошибка не уходит, запустите тот же экспорт в редакторе Godot и посмотрите подробности."},
	"export_web_readme": {"en": "{game} - made with EasyForge. Browsers block games opened straight from disk, so either: 1) upload this whole folder to any static host (itch.io works great) and share the link; or 2) run a small local web server in this folder and open the address it prints. Made with EasyForge.", "hi": "{game} — EasyForge से बना। ब्राउज़र डिस्क से सीधे खुलने वाले गेम रोकते हैं: 1) यह पूरा फ़ोल्डर किसी भी स्टैटिक होस्टिंग (itch.io बेहतर) पर डालें और लिंक साझा करें; या 2) इस फ़ोल्डर में छोटा लोकल वेब सर्वर चलाएँ और दिखाया गया पता खोलें। EasyForge से बना।", "es": "{game} - creado con EasyForge. Los navegadores bloquean los juegos abiertos directamente desde el disco: 1) sube esta carpeta completa a cualquier anfitrión estático (itch.io funciona muy bien) y comparte el enlace; o 2) ejecuta un pequeño servidor web local en esta carpeta y abre la dirección que muestre. Creado con EasyForge.", "zh": "{game} —— 用 EasyForge 制作。浏览器不允许直接打开硬盘上的游戏：1) 把整个文件夹上传到任意静态托管（itch.io 很合适）并分享链接；或 2) 在此文件夹启动一个小型本地网页服务器，然后打开它显示的地址。", "ar": "{game} — صُنع باستخدام EasyForge. المتصفحات تمنع الألعاب المفتوحة من القرص مباشرة: 1) ارفع هذا المجلد كاملاً إلى أي استضافة ثابتة (مثل itch.io) وشارك الرابط؛ أو 2) شغّل خادم ويب محلي صغير في هذا المجلد وافتح العنوان الذي يظهر. صُنع باستخدام EasyForge.", "pt": "{game} - criado com EasyForge. Os navegadores bloqueiam jogos abertos direto do disco: 1) envie esta pasta inteira para qualquer hospedagem estática (itch.io funciona muito bem) e compartilhe o link; ou 2) rode um pequeno servidor web local nesta pasta e abra o endereço mostrado. Criado com EasyForge.", "fr": "{game} - créé avec EasyForge. Les navigateurs bloquent les jeux ouverts directement sur le disque : 1) téléversez ce dossier entier sur un hébergeur statique (itch.io convient très bien) et partagez le lien ; ou 2) lancez un petit serveur web local dans ce dossier et ouvrez l'adresse affichée. Créé avec EasyForge.", "de": "{game} - erstellt mit EasyForge. Browser blockieren Spiele, die direkt von der Festplatte geöffnet werden: 1) lade diesen ganzen Ordner auf einen kostenlosen Hoster wie itch.io hoch und teile den Link; oder 2) starte einen kleinen lokalen Webserver in diesem Ordner und öffne die angezeigte Adresse. Erstellt mit EasyForge.", "ja": "{game} — EasyForge で制作。ブラウザはディスクから直接開いたゲームをブロックします。1) このフォルダごと itch.io などの静的ホスティングにアップロードしてリンクを共有、または 2) このフォルダで小さなローカルWebサーバーを起動して表示されたアドレスを開いてください。", "ru": "{game} — сделано в EasyForge. Браузеры блокируют игры, открытые прямо с диска: 1) загрузите эту папку целиком на любой статический хостинг (itch.io отлично подходит) и поделитесь ссылкой; или 2) запустите небольшой локальный веб-сервер в этой папке и откройте показанный адрес. Сделано в EasyForge."},
	"preview_live": {"en": "Live preview — press Play for full window", "hi": "लाइव प्रीव्यू — पूरी विंडो के लिए खेलें दबाएँ", "es": "Vista previa en directo — pulsa Jugar para verlo a pantalla completa", "zh": "实时预览——点击开始即可全屏显示", "ar": "معاينة مباشرة — اضغط العب لملء النافذة", "pt": "Pré-visualização ao vivo — pressione Jogar para a janela inteira", "fr": "Aperçu en direct — appuyez sur Jouer pour la fenêtre entière", "de": "Live-Vorschau — drücke Spielen für das volle Fenster", "ja": "ライブプレビュー — プレイを押すと全画面になります", "ru": "Живой предпросмотр — нажмите «Играть» для окна на весь экран"},
	"redo_done": {"en": "Redid that change.", "hi": "आखिरी बदलाव दोबारा कर दिया।", "es": "Cambio rehecho.", "zh": "已重做刚才的改动。", "ar": "أُعيد آخر تعديل.", "pt": "Mudança refeita.", "fr": "Changement rétabli.", "de": "Änderung wiederholt.", "ja": "やり直しました。", "ru": "Изменение повторено."},
	"added_brick": {"en": "Added:", "hi": "जोड़ा:", "es": "Añadido:", "zh": "已添加：", "ar": "تمت إضافة:", "pt": "Adicionado:", "fr": "Ajouté :", "de": "Hinzugefügt:", "ja": "追加しました：", "ru": "Добавлено:"},
	"added_brick_hint": {"en": "Connect it to another brick to say what happens next.", "hi": "इसे दूसरे ब्रिक से जोड़कर बताएँ कि आगे क्या होगा।", "es": "Conéctalo a otro bloque para decir qué pasa después.", "zh": "把它和别的积木连起来，就能说明接下来做什么。", "ar": "اربطها بطوبة أخرى لتحديد ما يحدث بعدها.", "pt": "Conecte-o a outro bloco para dizer o que vem depois.", "fr": "Reliez-la à une autre brique pour dire ce qui vient ensuite.", "de": "Verbinde ihn mit einem anderen Baustein, um festzulegen, was als Nächstes passiert.", "ja": "ほかのブロックとつなぐと、次に何が起きるかを決められます。", "ru": "Соедините его с другим блоком, чтобы задать, что будет дальше."},
	"brick_deleted": {"en": "Brick deleted. Press Undo to get it back.", "hi": "ब्रिक हटा दिया। वापस पाने के लिए 'वापस करें' दबाएँ।", "es": "Bloque eliminado. Pulsa Deshacer para recuperarlo.", "zh": "积木已删除。按撤销可以找回。", "ar": "حُذفت الطوبة. اضغط تراجع لإرجاعها.", "pt": "Bloco excluído. Pressione Desfazer para trazê-lo de volta.", "fr": "Brique supprimée. Appuyez sur Annuler pour la récupérer.", "de": "Baustein gelöscht. Drücke Rückgängig, um ihn zurückzuholen.", "ja": "ブロックを削除しました。元に戻すを押すと復活します。", "ru": "Блок удалён. Нажмите «Отменить», чтобы вернуть его."},
	"pick_brick_first": {"en": "Click a brick first, then press that key.", "hi": "पहले एक ब्रिक पर क्लिक करें, फिर यह कुंजी दबाएँ।", "es": "Elige primero un bloque y luego usa esa tecla.", "zh": "先点一块积木，再按这个键。", "ar": "اختر طوبة أولًا ثم اضغط هذا المفتاح.", "pt": "Escolha primeiro um bloco e então use essa tecla.", "fr": "Choisissez d'abord une brique, puis utilisez cette touche.", "de": "Erst einen Baustein anklicken, dann diese Taste drücken.", "ja": "まずブロックをクリックしてから、そのキーを押してください。", "ru": "Сначала выберите блок, затем нажмите эту клавишу."},
	"rename_brick": {"en": "Name this brick", "hi": "इस ब्रिक का नाम लिखें", "es": "Escribe un nombre para el bloque", "zh": "给这块积木起个名字", "ar": "اكتب اسمًا للطوبة", "pt": "Dê um nome ao bloco", "fr": "Donnez un nom à la brique", "de": "Benenne diesen Baustein", "ja": "ブロックに名前をつける", "ru": "Назовите этот блок"},
	"rename_brick_tip": {"en": "Pick a name that makes sense to you", "hi": "ऐसा नाम चुनें जो आपको समझ आए", "es": "Ponle un nombre que tú entiendas", "zh": "起一个你自己看得懂的名字", "ar": "اختر اسمًا يفيدك أنت", "pt": "Escolha um nome que você entenda", "fr": "Choisissez un nom qui vous parle", "de": "Gib ihm einen Namen, der dir etwas sagt", "ja": "自分に分かる名前を付けてください", "ru": "Выберите понятное вам имя"},
	"wire_connected": {"en": "Connected. Now press Play to see it work.", "hi": "जुड़ गया। अब खेलें दबाकर देखें।", "es": "Conectado. Pulsa Jugar para verlo funcionar.", "zh": "已连接。现在点击开始看看效果。", "ar": "تم الربط. اضغط العب لترى النتيجة.", "pt": "Conectado. Agora pressione Jogar para ver funcionar.", "fr": "Connecté. Appuyez sur Jouer pour voir le résultat.", "de": "Verbunden. Drücke Spielen, um zu sehen, wie es läuft.", "ja": "つながりました。プレイを押して動くか確かめましょう。", "ru": "Соединено. Нажмите «Играть», чтобы проверить."},
	"wire_rejected": {"en": "Those two bricks can't be connected. Try another pair.", "hi": "ये दोनों ब्रिक नहीं जुड़ेंगे। कोई और जोड़ा आज़माएँ।", "es": "Esos dos bloques no se pueden conectar. Prueba con otros.", "zh": "这两块积木连不到一起。换一对试试。", "ar": "لا يمكن ربط هاتين الطوبتين. جرّب غيرهما.", "pt": "Esses dois blocos não podem ser conectados. Tente outro par.", "fr": "Ces deux briques ne peuvent pas être reliées. Essayez une autre paire.", "de": "Diese beiden Bausteine lassen sich nicht verbinden. Versuche ein anderes Paar.", "ja": "この2つのブロックは結べません。別の組み合わせでためしてみてください。", "ru": "Эти два блока соединить нельзя. Попробуйте другую пару."},
	"wire_removed": {"en": "Connection removed.", "hi": "जुड़ाव हटा दिया।", "es": "Conexión eliminada.", "zh": "已移除连接。", "ar": "أُزيلت الوصلة.", "pt": "Conexão removida.", "fr": "Liaison supprimée.", "de": "Verbindung entfernt.", "ja": "つながりを解除しました。", "ru": "Соединение убрано."},
	"saved_ok": {"en": "Saved!", "hi": "सेव हो गया!", "es": "¡Guardado!", "zh": "已保存！", "ar": "تم الحفظ!", "pt": "Salvo!", "fr": "Enregistré !", "de": "Gespeichert!", "ja": "保存しました！", "ru": "Сохранено!"},
	"restored_project": {"en": "Welcome back to your game", "hi": "आपके गेम में वापस स्वागत है", "es": "De vuelta a tu juego", "zh": "欢迎回来，这是你的游戏", "ar": "مرحبًا بعودتك إلى لعبتك", "pt": "Bem-vindo de volta ao seu jogo", "fr": "Bon retour dans votre jeu", "de": "Willkommen zurück bei deinem Spiel", "ja": "前回のゲームを開きました", "ru": "С возвращением — вот ваша игра"},
	"backed_up": {"en": "your earlier game is safe under Open", "hi": "आपका पिछला गेम सुरक्षित है — ओपन में मिलेगा", "es": "tu juego anterior está guardado en Abrir", "zh": "你之前的游戏已保存，可在「打开」里找到", "ar": "لعبتك السابقة محفوظة، ستجدها في «فتح»", "pt": "seu jogo anterior está guardado em Abrir", "fr": "votre jeu précédent est gardé dans Ouvrir", "de": "dein vorheriges Spiel ist unter Öffnen gesichert", "ja": "さっきのゲームは「開く」に残しています", "ru": "прежняя игра сохранена — она есть в «Открыть»"},
	"autosave": {"en": "Last autosave", "hi": "आखिरी ऑटोसेव", "es": "Último autoguardado", "zh": "最近自动保存", "ar": "آخر حفظ تلقائي", "pt": "Último salvamento automático", "fr": "Dernière sauvegarde auto", "de": "Letzte automatische Speicherung", "ja": "最新の自動保存", "ru": "Последнее автосохранение"},
	"open_project": {"en": "Open saved game", "hi": "सेव गेम खोलें", "es": "Abrir juego guardado", "zh": "打开已保存的游戏", "ar": "افتح لعبة محفوظة", "pt": "Abrir jogo salvo", "fr": "Ouvrir un jeu enregistré", "de": "Gespeichertes Spiel öffnen", "ja": "保存したゲームを開く", "ru": "Открыть сохранённую игру"},
	"opened": {"en": "Opened", "hi": "खोल लिया", "es": "Abierto", "zh": "已打开", "ar": "تم الفتح", "pt": "Aberto", "fr": "Ouvert", "de": "Geöffnet", "ja": "開きました", "ru": "Открыто"},
	"open_failed": {"en": "Couldn't open that one.", "hi": "वह गेम नहीं खुल सका।", "es": "No se pudo abrir ese juego.", "zh": "打不开那个游戏。", "ar": "لم يفتح تلك اللعبة.", "pt": "Não foi possível abrir esse jogo.", "fr": "Impossible d'ouvrir ce jeu.", "de": "Das ließ sich nicht öffnen.", "ja": "そのファイルは開けませんでした。", "ru": "Не удалось открыть эту игру."},
	"open_none": {"en": "No saved games yet. Press Ctrl+S to save.", "hi": "अभी कोई सेव गेम नहीं। सहेजने के लिए Ctrl+S दबाएँ।", "es": "Todavía no hay juegos guardados. Pulsa Ctrl+S para guardar.", "zh": "还没有保存的游戏。按 Ctrl+S 保存。", "ar": "لا توجد ألعاب محفوظة بعد. اضغط Ctrl+S للحفظ.", "pt": "Nenhum jogo salvo ainda. Pressione Ctrl+S para salvar.", "fr": "Aucun jeu enregistré pour l'instant. Appuyez sur Ctrl+S pour enregistrer.", "de": "Noch keine gespeicherten Spiele. Drücke Ctrl+S zum Speichern.", "ja": "保存されたゲームはまだありません。Ctrl+Sで保存してください。", "ru": "Пока нет сохранённых игр. Нажмите Ctrl+S, чтобы сохранить."},
	"ai_draft_done": {"en": "Your game is ready — press Play to try it!", "hi": "आपका गेम तैयार है! खेलें दबाकर आज़माएँ।", "es": "¡Tu juego está listo! Pulsa Jugar para probarlo.", "zh": "你的游戏做好了！点击开始试试。", "ar": "لعبتك جاهزة! اضغط العب لتجربتها.", "pt": "Seu jogo está pronto! Pressione Jogar para testar.", "fr": "Votre jeu est prêt ! Appuyez sur Jouer pour l'essayer.", "de": "Dein Spiel ist fertig! Drücke Spielen, um es zu testen.", "ja": "ゲームができました！プレイを押して試してみてください。", "ru": "Ваша игра готова! Нажмите «Играть», чтобы попробовать."},
	"tidy_ai": {"en": "Tidy with AI", "hi": "AI से सजाएँ", "es": "Ordenar con IA", "zh": "用AI整理", "ar": "رتّب بالذكاء الاصطناعي", "pt": "Ajeitar com IA", "fr": "Ranger avec l'IA", "de": "Mit KI aufräumen", "ja": "AIで整える", "ru": "Навести порядок с ИИ"},
	"tidy_ai_tip": {"en": "Ask the AI to fix the wiring so your game runs properly", "hi": "AI से कहें कि जुड़ाव ठीक करे ताकि गेम चले", "es": "Pide a la IA que arregle las conexiones para que el juego funcione", "zh": "让AI把连线理顺，游戏就能正常运行", "ar": "دع الذكاء الاصطناعي يضبّط الوصلات حتى تعمل اللعبة", "pt": "Peça à IA para ajeitar as ligações e o jogo funcionar direito", "fr": "Demandez à l'IA de remettre les liaisons au propre pour que le jeu tourne", "de": "Lass die KI die Verbindungen ordnen, damit dein Spiel richtig läuft", "ja": "AIにつなぎ目を整えさせて、ゲームが動くようにします", "ru": "Попросите ИИ привести соединения в порядок, чтобы игра заработала"},
	"help_title": {"en": "How EasyForge works", "hi": "EasyForge कैसे काम करता है", "es": "Cómo funciona EasyForge", "zh": "EasyForge 怎么用", "ar": "كيف يعمل EasyForge", "pt": "Como o EasyForge funciona", "fr": "Comment fonctionne EasyForge", "de": "So funktioniert EasyForge", "ja": "EasyForgeの使い方", "ru": "Как работает EasyForge"},
	"help_1": {"en": "1. Describe your game in plain words at the top left, then press Build with AI.", "hi": "1. ऊपर बाईं ओर अपने गेम को आसान बातों में लिखें, फिर AI से बनाएं दबाएँ।", "es": "1. Describe tu juego con palabras normales arriba a la izquierda y pulsa Crear con IA.", "zh": "1. 在左上方用大白话描述你的游戏，然后点用AI生成。", "ar": "١. صِف لعبتك بكلمات بسيطة في الأعلى على اليسار، ثم اضغط أنشئ بالذكاء الاصطناعي.", "pt": "1. Descreva seu jogo com palavras simples no canto superior esquerdo e pressione Criar com IA.", "fr": "1. Décrivez votre jeu avec des mots simples en haut à gauche, puis appuyez sur Créer avec l'IA.", "de": "1. Beschreibe dein Spiel oben links in einfachen Worten und drücke Mit KI erstellen.", "ja": "1. 左上にゲームを簡単な言葉で書いて、AIで作るを押します。", "ru": "1. Опишите игру простыми словами слева сверху и нажмите «Создать с ИИ»."},
	"help_2": {"en": "2. Your game appears as bricks on the canvas. Each brick does one thing, like moving or counting points.", "hi": "2. आपका गेम कैनवास पर ब्रिक के रूप में दिखेगा। हर ब्रिक एक काम करता है — जैसे चलना या स्कोर गिनना।", "es": "2. Tu juego aparece como bloques en el lienzo. Cada bloque hace una cosa, como moverse o sumar puntos.", "zh": "2. 游戏会变成画布上的积木。每块积木只管一件事，比如移动或算分。", "ar": "٢. تظهر لعبتك كطوب على اللوحة. كل طوبة مسئولة عن شيء واحد، مثل الحركة أو النقاط.", "pt": "2. Seu jogo aparece como blocos na tela. Cada bloco faz uma coisa, como mover ou contar pontos.", "fr": "2. Votre jeu apparaît en briques sur le canevas. Chaque brique fait une chose, comme se déplacer ou compter les points.", "de": "2. Dein Spiel erscheint als Bausteine auf der Fläche. Jeder Baustein steht für eine Sache, z. B. Bewegen oder Punkte zählen.", "ja": "2. ゲームはブロックとして画面に並びます。ブロック1つが1つの役割を持ちます。移動やスコアなどです。", "ru": "2. Игра появится на холсте в виде блоков. Каждый блок делает что-то одно — например, движет или считает очки."},
	"help_3": {"en": "3. Drag from the right side of one brick to the left side of another to say what happens next.", "hi": "3. एक ब्रिक के दाईं ओर से दूसरे ब्रिक के बाईं ओर लाइन खींचें, यह बताने के लिए कि आगे क्या होगा।", "es": "3. Arrastra del lado derecho de un bloque al lado izquierdo de otro para decir qué pasa después.", "zh": "3. 从一块积木的右边拖到另一块的左边，就能说明接下来发生什么。", "ar": "٣. اسحب من الجانب الأيمن لطوبة إلى الجانب الأيسر لأخرى لتحدد ما يحدث بعد ذلك.", "pt": "3. Arraste do lado direito de um bloco para o lado esquerdo de outro para dizer o que acontece depois.", "fr": "3. Glissez du côté droit d'une brique vers le côté gauche d'une autre pour dire ce qui vient ensuite.", "de": "3. Ziehe eine Linie von der rechten Seite eines Bausteins zur linken Seite eines anderen, um festzulegen, was danach passiert.", "ja": "3. ブロックの右側から別のブロックの左側へ線を引くと、次に何が起きるかを決められます。", "ru": "3. Проведите линию от правого края одного блока к левому краю другого — так вы зададите, что будет дальше."},
	"help_4": {"en": "4. Press Play to try your game right here. Press Esc or Stop to go back to editing.", "hi": "4. खेलें दबाकर अपना गेम यहीं आज़माएँ। Esc या रोकें दबाकर वापस संपादन पर लौटें।", "es": "4. Pulsa Jugar para probar tu juego aquí mismo. Pulsa Esc o Detener para volver a editar.", "zh": "4. 点击开始就能在这里试玩。按 Esc 或停止就回到编辑。", "ar": "٤. اضغط العب لتجربة لعبتك هنا. اضغط Esc أو إيقاف للعودة إلى التعديل.", "pt": "4. Pressione Jogar para testar seu jogo aqui mesmo. Pressione Esc ou Parar para voltar a editar.", "fr": "4. Appuyez sur Jouer pour essayer votre jeu ici même. Appuyez sur Esc ou Arrêter pour revenir à l'édition.", "de": "4. Drücke Spielen, um dein Spiel hier direkt zu testen. Drücke Esc oder Stoppen, um weiterzuarbeiten.", "ja": "4. プレイを押すとこの場で遊べます。Escか停止で編集に戻ります。", "ru": "4. Нажмите «Играть», чтобы попробовать игру прямо здесь. Esc или «Стоп» вернут к редактору."},
	"help_5": {"en": "5. Want a change? Type it in the Edit with AI box, for example \"make it harder\".", "hi": "5. कोई बदलाव चाहिए? AI से बदलें वाले बॉक्स में लिखें, जैसे इसे और कठिन बनाओ।", "es": "5. ¿Quieres un cambio? Escríbelo en el cuadro Editar con IA, por ejemplo «hazlo más difícil».", "zh": "5. 想改动？在「用AI修改」框里写一句，比如「更难一点」。", "ar": "٥. تريد تعديلًا؟ اكتبه في مربع عدّل بالذكاء الاصطناعي، مثل «اجعلها أصعب».", "pt": "5. Quer mudar algo? Escreva no campo Editar com IA, por exemplo \"deixe mais difícil\".", "fr": "5. Envie d'un changement ? Écrivez-le dans la box Modifier avec l'IA, par exemple « rends-le plus difficile ».", "de": "5. Du willst etwas ändern? Schreib es ins Feld Mit KI bearbeiten, zum Beispiel „schwieriger machen“.", "ja": "5. 変更したいときはAIで編集の欄に「もっと難しくして」などと書いてください。", "ru": "5. Хотите изменений? Напишите в поле «Изменить с ИИ», например «сделай посложнее»."},
	"help_shortcuts": {"en": "Keys: Ctrl+Z undo, Ctrl+Shift+Z redo, Ctrl+C copy, Ctrl+V paste, Ctrl+D duplicate, Ctrl+S save, Delete removes a brick, Esc stops the game, + / - / 0 zoom, WASD or arrow keys pan the canvas.", "hi": "कुंजियाँ: Ctrl+Z वापस करें, Ctrl+Shift+Z दोबारा करें, Ctrl+C कॉपी, Ctrl+V पेस्ट, Ctrl+D डुप्लिकेट, Ctrl+S सहेजें, Delete ब्रिक हटाएँ, Esc गेम रोकें, + / - / 0 ज़ूम, WASD या तीरों से कैनवास घूमें।", "es": "Teclas: Ctrl+Z deshacer, Ctrl+Shift+Z rehacer, Ctrl+C copiar, Ctrl+V pegar, Ctrl+D duplicar, Ctrl+S guardar, Supr quita un bloque, Esc para el juego, + / - / 0 zoom, WASD o flechas mueven el lienzo.", "zh": "按键：Ctrl+Z 撤销，Ctrl+Shift+Z 重做，Ctrl+C 复制，Ctrl+V 粘贴，Ctrl+D 复制副本，Ctrl+S 保存，Delete 删除积木，Esc 停止游戏，+ / - / 0 缩放，WASD 或方向键移动画布。", "ar": "المفاتيح: Ctrl+Z تراجع، Ctrl+Shift+Z إعادة، Ctrl+C نسخ، Ctrl+V لصق، Ctrl+D تكرار، Ctrl+S حفظ، Delete حذف طوبة، Esc إيقاف اللعبة، + / - / 0 تكبير/تصغير، WASD أو الأسهم لتحريك اللوحة.", "pt": "Teclas: Ctrl+Z desfazer, Ctrl+Shift+Z refazer, Ctrl+C copiar, Ctrl+V colar, Ctrl+D duplicar, Ctrl+S salvar, Delete tira um bloco, Esc para o jogo, + / - / 0 zoom, WASD ou setas movem a tela.", "fr": "Touches : Ctrl+Z annuler, Ctrl+Shift+Z rétablir, Ctrl+C copier, Ctrl+V coller, Ctrl+D dupliquer, Ctrl+S enregistrer, Suppr enlève une brique, Esc arrête le jeu, + / - / 0 zoom, WASD ou flèches déplacent le canevas.", "de": "Tasten: Ctrl+Z rückgängig, Ctrl+Umschalt+Z wiederholen, Ctrl+C kopieren, Ctrl+V einfügen, Ctrl+D duplizieren, Ctrl+S speichern, Entf entfernt einen Baustein, Esc stoppt das Spiel, + / - / 0 Zoom, WASD oder Pfeile bewegen die Fläche.", "ja": "キー：Ctrl+Z 元に戻す、Ctrl+Shift+Z やり直し、Ctrl+C コピー、Ctrl+V 貼り付け、Ctrl+D 複製、Ctrl+S 保存、Delete でブロック削除、Esc でゲーム停止、+ / - / 0 でズーム、WASDや矢印で画面を移動。", "ru": "Клавиши: Ctrl+Z отменить, Ctrl+Shift+Z повторить, Ctrl+C копировать, Ctrl+V вставить, Ctrl+D дублировать, Ctrl+S сохранить, Delete убирает блок, Esc останавливает игру, + / - / 0 масштаб, WASD или стрелки двигают холст."},
	"help_tip": {"en": "Nothing here is final — every brick can be changed or removed later.", "hi": "यहाँ कुछ भी पक्का नहीं — कोई भी ब्रिक बाद में बदल या हटा सकते हैं।", "es": "Nada es definitivo: cualquier bloque se puede cambiar o quitar más tarde.", "zh": "这里没有什么是定死的——任何积木之后都能改或删。", "ar": "لا شيء هنا نهائي — يمكنك تغيير أي طوبة أو حذفها لاحقًا.", "pt": "Nada aqui é definitivo — todo bloco pode ser mudado ou removido depois.", "fr": "Rien n'est définitif ici — chaque brique peut être modifiée ou supprimée plus tard.", "de": "Nichts ist endgültig — jeden Baustein kannst du später ändern oder löschen.", "ja": "どのブロックも、あとから変更も削除ができます。やり直せば大丈夫です。", "ru": "Здесь ничего окончательно — любой блок можно позже изменить или убрать."},
	"export_game_copying": {"en": "Copying the player so your game runs on its own...", "hi": "प्लेयर कॉपी हो रहा है, ताकि गेम अकेले चल सके...", "es": "Copiando el motor para que tu juego funcione solo...", "zh": "正在复制运行程序，让你的游戏能独立运行...", "ar": "يجري نسخ المشغّل لتعمل لعبتك وحدها...", "pt": "Copiando o jogador para que seu jogo rode sozinho...", "fr": "Copie du lecteur pour que votre jeu fonctionne seul...", "de": "Der Spieler wird kopiert, damit dein Spiel allein läuft...", "ja": "ゲームを単独で動かせるよう、実行ファイルをコピーしています...", "ru": "Копируем проигрыватель, чтобы игра запускалась сама..."},
	"export_game_done": {"en": "Your game is ready to send! The folder is opening now.", "hi": "आपका गेम भेजने के लिए तैयार! फ़ोल्डर खुल रहा है।", "es": "¡Tu juego está listo para enviar! La carpeta se está abriendo.", "zh": "你的游戏可以发送了！文件夹正在打开。", "ar": "لعبتك جاهزة للإرسال! يفتح المجلد الآن.", "pt": "Seu jogo está pronto para enviar! A pasta está abrindo.", "fr": "Votre jeu est prêt à envoyer ! Le dossier s'ouvre.", "de": "Dein Spiel ist fertig zum Verschicken! Der Ordner wird geöffnet.", "ja": "ゲームは送る準備ができました！フォルダを開いています。", "ru": "Игра готова к отправке! Папка открывается."},
	"export_game_failed_copy": {"en": "Couldn't copy the game files. Close any window using them and try again.", "hi": "गेम की फ़ाइलें कॉपी नहीं हो सकीं। उन्हें उपयोग कर विंडो बंद करें और दोबारा आज़माएँ।", "es": "No se pudieron copiar los archivos del juego. Cierra las ventanas que los usen e inténtalo de nuevo.", "zh": "无法复制游戏文件。请关闭使用它们的窗口后重试。", "ar": "تعذّر نسخ ملفات اللعبة. أغلق النوافذ التي تستخدمها ثم أعد المحاولة.", "pt": "Não foi possível copiar os arquivos do jogo. Feche as janelas que os usam e tente de novo.", "fr": "Impossible de copier les fichiers du jeu. Fermez les fenêtres qui les utilisent et réessayez.", "de": "Die Spieldateien konnten nicht kopiert werden. Schließe die Fenster, die sie nutzen, und versuche es erneut.", "ja": "ゲームのファイルをコピーできませんでした。使用中のウィンドウを閉じてもう一度お試しください。", "ru": "Не удалось скопировать файлы игры. Закройте использующие их окна и попробуйте снова."},
	"export_game_failed_dir": {"en": "Couldn't create the folder for your game. Check your disk space and try again.", "hi": "आपके गेम के लिए फ़ोल्डर नहीं बन सका। जगह देखें और दोबारा आज़माएँ।", "es": "No se pudo crear la carpeta para tu juego. Revisa el espacio en disco y vuelve a intentarlo.", "zh": "无法为你的游戏创建文件夹。请检查磁盘空间后重试。", "ar": "لم نتمكن من إنشاء مجلد للعبة. تحقق من مساحة القرص وأعد المحاولة.", "pt": "Não foi possível criar a pasta do seu jogo. Veja o espaço em disco e tente de novo.", "fr": "Impossible de créer le dossier de votre jeu. Vérifiez l'espace disque et réessayez.", "de": "Der Ordner für dein Spiel konnte nicht angelegt werden. Prüfe den Speicherplatz und versuche es erneut.", "ja": "ゲーム用のフォルダを作れませんでした。空き容量を確認してもう一度お試しください。", "ru": "Не удалось создать папку для игры. Проверьте место на диске и попробуйте снова."},
	"export_game_failed_save": {"en": "Couldn't save your game into that folder. Try again.", "hi": "आपका गेम उस फ़ोल्डर में सेव नहीं हुआ। दोबारा आज़माएँ।", "es": "No se pudo guardar tu juego en esa carpeta. Inténtalo otra vez.", "zh": "无法把游戏保存到那个文件夹。请重试。", "ar": "تعذّر حفظ اللعبتك في هذا المجلد. أعد المحاولة.", "pt": "Não deu para salvar seu jogo nessa pasta. Tente novamente.", "fr": "Impossible d'enregistrer votre jeu dans ce dossier. Réessayez.", "de": "Dein Spiel konnte nicht in diesen Ordner gespeichert werden. Versuche es erneut.", "ja": "そのフォルダにゲームを保存できませんでした。もう一度お試しください。", "ru": "Не удалось сохранить игру в эту папку. Попробуйте ещё раз."},
	"export_game_incomplete": {"en": "The exported folder is missing a file. Press the rocket button again.", "hi": "निकले गए फ़ोल्डर में एक फ़ाइल छूट गई। रॉकेट बटन दोबारा दबाएँ।", "es": "A la carpeta exportada le falta un archivo. Pulsa otra vez el botón del cohete.", "zh": "导出的文件夹里少了一个文件。请再点一次火箭按钮。", "ar": "ينقص المجلد المُصدَّر ملف. اضغط زر الصاروخ من جديد.", "pt": "Falta um arquivo na pasta exportada. Pressione o botão do foguete de novo.", "fr": "Il manque un fichier dans le dossier exporté. Appuyez de nouveau sur le bouton fusée.", "de": "Im exportierten Ordner fehlt eine Datei. Drücke noch einmal den Raketen-Knopf.", "ja": "書き出したフォルダにファイルが1つ足りません。ロケットボタンをもう一度押してください。", "ru": "В выгруженной папке не хватает файла. Нажмите кнопку ракеты ещё раз."},
	"export_game_no_player": {"en": "Couldn't find the game player inside EasyForge. Run EasyForge from its own folder, then try again.", "hi": "EasyForge के अंदर गेम प्लयर नहीं मिला। EasyForge को अपने फ़ोल्डर से चलाएँ, फिर आज़माएँ।", "es": "No se encontró el motor del juego dentro de EasyForge. Ejecuta EasyForge desde su propia carpeta y vuelve a intentarlo.", "zh": "在 EasyForge 里找不到游戏播放器。请从 EasyForge 自己的文件夹运行后再试。", "ar": "لم يُعثر على مشغّل اللعبة داخل EasyForge. شغّل EasyForge من مجلده ثم أعد المحاولة.", "pt": "Não encontramos o jogador do jogo dentro do EasyForge. Rode o EasyForge da própria pasta dele e tente de novo.", "fr": "Le lecteur de jeu est introuvable dans EasyForge. Lancez EasyForge depuis son propre dossier puis réessayez.", "de": "Der Spieler wurde in EasyForge nicht gefunden. Starte EasyForge aus seinem eigenen Ordner und versuche es erneut.", "ja": "EasyForge の中にゲームの実行ファイルが見つかりませんでした。EasyForge を自身のフォルダから起動して再試行してください。", "ru": "Не удалось найти проигрыватель игры внутри EasyForge. Запустите EasyForge из его папки и попробуйте снова."},
	"export_game_readme": {"en": "How to play {game}: double-click {game}.exe on any Windows PC — no install, no internet needed. Press Esc to stop. Made with EasyForge.", "hi": "{game} कैसे खेलें: किसी भी Windows कंप्यूटर पर {game}.exe पर डबल-क्लिक करें — इंस्टॉल या इंटरनेट की ज़रूरत नहीं। रोकने के लिए Esc दबाएँ। EasyForge से बनाया गया।", "es": "Cómo jugar a {game}: haz doble clic en {game}.exe en cualquier PC con Windows, sin instalar nada y sin internet. Pulsa Esc para parar. Creado con EasyForge.", "zh": "《{game}》玩法：在任何 Windows 电脑上双击 {game}.exe 就能玩，不用安装，也不用上网。按 Esc 退出。由 EasyForge 制作。", "ar": "كيفية لعب {game}: انقر نقرًا مزدوج على {game}.exe على أي حاسوب Windows — بلا تثبيت وبلا إنترنت. اضغط Esc للإيقاف. صُنعت باستخدام EasyForge.", "pt": "Como jogar {game}: dê dois cliques em {game}.exe em qualquer PC com Windows — sem instalar nada e sem internet. Pressione Esc para parar. Feito com EasyForge.", "fr": "Comment jouer à {game} : double-cliquez sur {game}.exe sur n'importe quel PC Windows, sans installation ni internet. Appuyez sur Esc pour arrêter. Créé avec EasyForge.", "de": "So spielst du {game}: Doppelklick auf {game}.exe auf jedem Windows-PC — ohne Installation und ohne Internet. Drücke Esc zum Stoppen. Gemacht mit EasyForge.", "ja": "『{game}』の遊び方：Windowsのパソコンで {game}.exe をダブルクリックするだけです。インストールもインターネットも不要です。やめるときは Esc を押してください。EasyForge で作成しました。", "ru": "Как играть в «{game}»: дважды щёлкните {game}.exe на любом Windows-компьютере — установка и интернет не нужны. Нажмите Esc, чтобы остановить. Сделано в EasyForge."},
	"export_game_tip": {"en": "Make a game file you can send to a friend — double-click and play", "hi": "गेम की फ़ाइल बनाएँ जिसे दोस्त को भेज सकें — डबल-क्लिक करके खेलें", "es": "Crea un archivo de juego para enviar a un amigo: doble clic y a jugar", "zh": "生成可以发给朋友的游戏文件——双击就能玩", "ar": "أنشئ ملف لعبة ترسله لصديقك — نقر مزدوج وتلعب", "pt": "Crie um arquivo de jogo para mandar a um amigo — dois cliques e pronto", "fr": "Créez un fichier de jeu à envoyer à un ami — double-clic et on joue", "de": "Erstelle eine Spieldatei zum Verschicken — Doppelklick und los", "ja": "友達に送れるゲームファイルを作ります — ダブルクリックで遊べます", "ru": "Создайте файл игры, который можно отправить другу — двойной щелчок, и играй"},
	"export_game_writing": {"en": "Saving your game...", "hi": "आपका गेम सेव हो रहा है...", "es": "Guardando tu juego...", "zh": "正在保存你的游戏...", "ar": "يجري حفظ لعبتك...", "pt": "Salvando seu jogo...", "fr": "Enregistrement de votre jeu...", "de": "Dein Spiel wird gespeichert...", "ja": "ゲームを保存しています...", "ru": "Сохраняем вашу игру..."},
	"quit": {"en": "Quit the game", "hi": "गेम बंद करें", "es": "Salir del juego", "zh": "退出游戏", "ar": "خروج من اللعبة", "pt": "Sair do jogo", "fr": "Quitter le jeu", "de": "Spiel verlassen", "ja": "ゲームを終了", "ru": "Выйти из игры"},
	"save_failed": {"en": "Couldn't save that. Try again.", "hi": "वह सेव नहीं हुआ। दोबारा आज़माएँ।", "es": "No se pudo guardar. Inténtalo de nuevo.", "zh": "保存失败。请重试。", "ar": "تعذّر الحفظ. أعد المحاولة.", "pt": "Não foi possível salvar. Tente de novo.", "fr": "Enregistrement impossible. Réessayez.", "de": "Das konnte nicht gespeichert werden. Versuche es erneut.", "ja": "保存できませんでした。もう一度お試しください。", "ru": "Не удалось сохранить. Попробуйте ещё раз."},
	"save_game_file_tip": {"en": "Save your game file", "hi": "अपनी गेम फ़ाइल सहेजें", "es": "Guarda el archivo de tu juego", "zh": "保存你的游戏文件", "ar": "احفظ ملف لعبتك", "pt": "Salve o arquivo do seu jogo", "fr": "Enregistrez le fichier de votre jeu", "de": "Speichere deine Spieldatei", "ja": "ゲームファイルを保存する", "ru": "Сохранить файл вашей игры"},
	"ai_model": {"en": "AI Model", "hi": "AI मॉडल", "es": "Modelo de IA", "zh": "AI模型", "ar": "نموذج الذكاء الاصطناعي", "pt": "Modelo de IA", "fr": "Modèle d'IA", "de": "KI-Modell", "ja": "AIモデル", "ru": "Модель ИИ"},
	"ai_edit_needed": {"en": "Tell the AI what to change first.", "hi": "पहले AI को बताएँ कि क्या बदलना है।", "es": "Dinos primero qué quieres cambiar.", "zh": "请先告诉 AI 你想改什么。", "ar": "اكتب ما تريد تغييره أولاً.", "pt": "Diga primeiro o que quer mudar.", "fr": "Indiquez d'abord ce que vous voulez changer.", "de": "Sag zuerst, was du ändern möchtest.", "ja": "まず、何を変えたいかを入力してね。", "ru": "Сначала напишите, что нужно изменить."},
	"lives": {"en": "Lives", "hi": "जीवन", "es": "Vidas", "zh": "生命", "ar": "أرواح", "pt": "Vidas", "fr": "Vies", "de": "Leben", "ja": "ライフ", "ru": "Жизни"},
	"net_error": {"en": "Could not reach the AI. Check your internet.", "hi": "AI से संपर्क नहीं हो सका। अपना इंटरनेट जांचें।", "es": "No pude conectar con la IA. Revisa tu internet.", "zh": "无法连接 AI。请检查网络。", "ar": "تعذّر الوصول إلى الذكاء الاصطناعي. تحقق من اتصالك بالإنترنت.", "pt": "Não consegui falar com a IA. Verifique sua internet.", "fr": "Impossible de joindre l'IA. Vérifiez votre connexion.", "de": "Die KI ist nicht erreichbar. Prüfe dein Internet.", "ja": "AIに接続できませんでした。ネット環境を確認して。", "ru": "Не удалось связаться с ИИ. Проверьте интернет."},
	"provider_error": {"en": "The AI provider returned error %d.", "hi": "AI प्रदाता ने त्रुटि %d दी।", "es": "El proveedor de IA devolvió el error %d.", "zh": "AI 服务商返回错误 %d。", "ar": "أعاد مزود الذكاء الاصطناعي الخطأ %d.", "pt": "O provedor de IA retornou erro %d.", "fr": "Le fournisseur d'IA a renvoyé l'erreur %d.", "de": "Der KI-Anbieter meldete Fehler %d.", "ja": "AIプロバイダがエラー %d を返しました。", "ru": "Провайдер ИИ вернул ошибку %d."},
	"model_unavailable": {"en": "That model name is not available. Open Settings and pick or type another one.", "hi": "यह मॉडल उपलब्ध नहीं है। सेटिंग्स खोलें और दूसरा चुनें या लिखें।", "es": "Ese modelo no está disponible. Abre Ajustes y elige o escribe otro.", "zh": "该模型不可用。打开设置，选择或输入另一个。", "ar": "هذا النموذج غير متاح. افتح الإعدادات واختر أو اكتب نموذجًا آخر.", "pt": "Esse modelo não está disponível. Abra Configurações e escolha ou digite outro.", "fr": "Ce modèle n'est pas disponible. Ouvrez les Paramètres et choisissez-en un autre.", "de": "Dieses Modell ist nicht verfügbar. Öffne die Einstellungen und wähle ein anderes.", "ja": "そのモデルは使えません。設定で別のものを選ぶか入力して。", "ru": "Такой модель недоступен. Откройте «Настройки» и выберите или впишите другой."},
	"rate_limited": {"en": "The free limit was reached. Wait a minute, then try again.", "hi": "मुफ़्त सीमा पूरी हो गई। एक मिनट रुककर फिर कोशिश करें।", "es": "Se alcanzó el límite gratuito. Espera un minuto e inténtalo otra vez.", "zh": "已达到免费额度。等一分钟再试。", "ar": "وصلت إلى الحد المجاني. انتظر دقيقة ثم حاول مجددًا.", "pt": "O limite gratuito foi atingido. Espere um minuto e tente de novo.", "fr": "La limite gratuite est atteinte. Attendez une minute et réessayez.", "de": "Das Gratis-Limit ist erreicht. Warte eine Minute und versuch es erneut.", "ja": "無料の上限に達しました。1分おいて再度どうぞ。", "ru": "Бесплатный лимит исчерпан. Подождите минуту и попробуйте снова."},
	"bad_reply": {"en": "The AI sent back something unreadable. Try again.", "hi": "AI ने समझ न आने वाली चीज़ भेजी। फिर कोशिश करें।", "es": "La IA devolvió algo ilegible. Inténtalo de nuevo.", "zh": "AI 返回了无法读出的内容。请重试。", "ar": "أعاد الذكاء الاصطناعي شيئًا غير مفهوم. حاول مجددًا.", "pt": "A IA devolveu algo ilegível. Tente novamente.", "fr": "L'IA a renvoyé quelque chose d'illisible. Réessayez.", "de": "Die KI hat etwas Unlesbares zurückgeschickt. Versuch es erneut.", "ja": "AIの中身が読めませんでした。もう一度どうぞ。", "ru": "ИИ прислал нечитаемый ответ. Попробуйте ещё раз."},
	"model_custom": {"en": "…or type a model name from your provider", "hi": "…या अपने प्रदाता का मॉडल नाम लिखें", "es": "…o escribe un modelo de tu proveedor", "zh": "…或输入你服务商的模型名", "ar": "…أو اكتب اسم نموذج من مزودك", "pt": "…ou digite um modelo do seu provedor", "fr": "…ou saisissez un modèle de votre fournisseur", "de": "…oder gib ein Modell deines Anbieters ein", "ja": "…または自分のプロバイダのモデル名を入力", "ru": "…или впишите модель вашего провайдера."},
	"ai_thinking_empty": {"en": "this model thinks before answering, so it may need more time", "hi": "यह मॉडल जवाब से पहले सोचता है, इसलिए समय ले सकता है", "es": "este modelo piensa antes de responder, puede tardar más", "zh": "该模型回答前会思考，可能更慢", "ar": "هذا النموذج يفكر قبل أن يجيب، قد يستغرق وقتًا", "pt": "este modelo pensa antes de responder, pode demorar", "fr": "ce modèle réfléchit avant de répondre, il peut être lent", "de": "dieses Modell denkt vor der Antwort, es kann dauern", "ja": "このモデルは答える前に考えるのでもっと時間がかかります", "ru": "эта модель думает перед ответом, может быть медленнее"},
	"ai_cut_off": {"en": "The AI ran out of room before finishing. Try a shorter idea, or pick a faster model in Settings.", "hi": "AI पूरी बात लिखने से पहले रुक गया। छोटा आइडिया लिखें या सेटिंग्स में तेज़ मॉडल चुनें।", "es": "La IA se quedó sin espacio antes de terminar. Prueba una idea más corta o un modelo más rápido en Ajustes.", "zh": "AI 没写完就被截断了。试试更简单的想法，或在设置里选更快的模型。", "ar": "لم يكمل الذكاء الاصطناعي الرد قبل نفاد المساحة. جرّب فكرة أقصر أو نموذجًا أسرع من الإعدادات.", "pt": "A IA ficou sem espaço antes de terminar. Tente uma ideia mais curta ou um modelo mais rápido nas Configurações.", "fr": "L'IA a manqué de place avant de terminer. Essayez une idée plus courte ou un modèle plus rapide dans les Paramètres.", "de": "Der KI ging der Platz aus, bevor sie fertig war. Versuch eine kürzere Idee oder ein schnelleres Modell in den Einstellungen.", "ja": "AIは書き終わる前に文字数切れになりました。もっと短いアイデアで試すか、設定で速いモデルを選んで。", "ru": "ИИ не успел закончить — закончилось место. Попробуйте короче описать идею или выбрать модель быстрее в «Настройках»."},
	"describe_short": {"en": "Describe your game", "hi": "अपना गेम बताएँ", "es": "Describe tu juego", "zh": "描述你的游戏", "ar": "صف لعبتك", "pt": "Descreva seu jogo", "fr": "Décrivez votre jeu", "de": "Beschreibe dein Spiel", "ja": "ゲームを説明して", "ru": "Опишите свою игру"},
	"manual_title": {"en": "Manual", "hi": "मैनुअल", "es": "Guía", "zh": "使用手册", "ar": "الدليل", "pt": "Guia", "fr": "Manuel", "de": "Handbuch", "ja": "マニュアル", "ru": "Справочник"},
