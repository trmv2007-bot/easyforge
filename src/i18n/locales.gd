	"problems_click_hint": {"en": "press a line to find that brick", "hi": "पंक्ति दबाएँ और ब्रिक ढूँढें", "es": "pulsa una línea para hallar el ladrillo", "zh": "点一行就跳到那块积木", "ar": "اضغط على سطر للعثور على الطوبة", "pt": "clique numa linha para achar o bloco", "fr": "clique une ligne pour montrer la brique", "de": "Zeile drücken, um den Baustein zu zeigen", "ja": "行を押すと該当ブロックへ", "ru": "нажми строку, чтобы найти блок"},
	"problem_error_tip": {"en": "This one stops Play", "hi": "यह खेलना रोक देता है", "es": "Esto impide Jugar", "zh": "这一条会挡住运行", "ar": "هذا يمنع التشغيل", "pt": "Isto impede o Jogar", "fr": "Celui-ci bloque Lecture", "de": "Das blockiert das Starten", "ja": "これが原因でプレイできません", "ru": "Из-за этого кнопка Играть не работает"},
